[Unit]
Description=Classroom Assessment durable recognition queue
After=network-online.target classroom-assessment-api.service classroom-recognition.service

[Service]
User=classroom-assessment
Group=classroom-assessment
WorkingDirectory=/opt/classroom-assessment-platform/current/backend
EnvironmentFile=/etc/classroom-assessment-platform/backend.env
ExecStart=/opt/classroom-assessment-platform/current/backend/.venv/bin/python -m app.scan_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/classroom-assessment-platform/data
UMask=027

[Install]
WantedBy=multi-user.target
